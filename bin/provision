#!/usr/bin/env bash

set -ex
source bin/_common.sh

required_vars=(DV_DO_SSH_KEY_FINGERPRINT DV_DO_SSH_KEY_PATH DV_ROUTE53_HOSTED_ZONE)
missing_vars=()
for var in "${required_vars[@]}"; do
  if [ -z "${!var}" ]; then
    missing_vars+=("${var}")
  fi
done
if [ ${#missing_vars[@]} -gt 0 ]; then
  echo "error: missing environment variables: ${missing_vars[@]}"
  exit 1
fi

DV_DROPLET_IP=$(get_droplet_ip)
if [ -n "${DV_DROPLET_IP}" ]; then
  echo "found existing droplet with tag ${DV_DO_TAG} at ${DV_DROPLET_IP}"
else
  echo "could not find existing droplet with tag ${DV_DO_TAG}"
fi

if [ -z ${DV_DROPLET_IP} ]; then
  echo "creating new droplet"
  doctl compute droplet create "${DV_DO_DROPLET_NAME}" \
    --image "${DV_DO_IMAGE}" \
    --size "${DV_DO_SIZE}" \
    --region "${DV_DO_REGION}" \
    --tag-names "digital-venue,${DV_DO_TAG}" \
    --ssh-keys "${DV_DO_SSH_KEY_FINGERPRINT}" \
    --wait

  DV_DROPLET_IP=$(get_droplet_ip)
  if [ -z ${DV_DROPLET_IP} ]; then
    echo "error: failed to get droplet ip after creation"
    exit 1
  fi
fi

if [ "${DV_ENV}" == "prod" ]; then
  DOMAIN="digital-venue.net"
  TTL=3600
else
  DOMAIN="${DV_ENV}.digital-venue.net"
  TTL=30
fi

cat > /tmp/route53-changes.json << EOF
{
  "Changes": [
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "${DOMAIN}",
        "Type": "A",
        "TTL": ${TTL},
        "ResourceRecords": [
          {
            "Value": "${DV_DROPLET_IP}"
          }
        ]
      }
    }
  ]
}
EOF

echo "upserting dns record set for domain ${DOMAIN}"
aws route53 change-resource-record-sets \
  --hosted-zone-id ${DV_ROUTE53_HOSTED_ZONE} \
  --change-batch file:///tmp/route53-changes.json

echo "waiting for droplet to be available"
while ! ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -i "${DV_DO_SSH_KEY_PATH}" root@${DV_DROPLET_IP} 'echo "ready"'; do
  echo "Still waiting..."
  sleep 5
done

echo "installing provisioning script"
scp -o ConnectTimeout=5 -o StrictHostKeyChecking=no -i "${DV_DO_SSH_KEY_PATH}" \
  provision/* \
  root@${DV_DROPLET_IP}:${DV_REMOTE_ROOT}

echo "executing provisioning script"
ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -i "${DV_DO_SSH_KEY_PATH}" \
  root@${DV_DROPLET_IP} \
  "IP_ADDRESS=${DV_DROPLET_IP} \
  ENVIRONMENT=${DV_ENV} \
  DOMAIN_NAME=${DOMAIN} \
  APP_VERSION=${DV_VERSION} \
  bash ${DV_REMOTE_ROOT}/provision.sh"

echo "provisioning complete!"
