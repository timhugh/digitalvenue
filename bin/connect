#!/usr/bin/env bash

set -ex
source bin/_common.sh

required_vars=(DV_DO_SSH_KEY_PATH)
missing_vars=()
for var in "${required_vars[@]}"; do
  if [ -z "${!var}" ]; then
    missing_vars+=("${var}")
  fi
done
if [ ${#missing_vars[@]} -gt 0 ]; then
  echo "error: missing environment variables: ${missing_vars[@]}"
  exit 1
fi

doctl compute ssh --ssh-key-path ${DV_DO_SSH_KEY_PATH} ${DV_DO_DROPLET_NAME}
