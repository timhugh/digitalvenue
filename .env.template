#
# DEPLOYMENT VARIABLES
# must be present on machine executing provision/deploy scripts

# the ssh key fingerprint of the key that will be installed on the machine
#   doctl compute ssh-key list
DV_DO_SSH_KEY_FINGERPRINT=aa:bb:cc

# the location of the corresponding private key on the local machine
DV_DO_SSH_KEY_PATH=~/.ssh/digitalocean_key

# the ID of the hosted zone to create a subdomain in
#   aws route53 list-hosted-zones
DV_ROUTE53_HOSTED_ZONE=ABCDEF

#
# APPLICATION VARIABLES
# necessary for the application to run

# url connection string for postgres database
DV_DATABASE_URL=postgres://

# url connection string for default postgres database (used to connect and create application database)
DV_DEFAULT_DATABASE_URL=postgres://

# webhook event url for square events -- must exactly match what is configured in Square
DV_SQUARE_WEBHOOK_URL=https://digital-venue.net/api/square/webhook_events
