[Unit]
Description=Digital Venue Server
After=network.target

[Service]
WorkingDirectory=/opt/digitalvenue/current
ExecStart=/opt/digitalvenue/current/dvserver
EnvironmentFile=/opt/digitalvenue/current/env
SyslogIdentifier=digitalvenue
StandardOutput=journal
StandardError=journal
SuccessExitStatus=143
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
